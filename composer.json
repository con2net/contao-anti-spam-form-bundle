{
  "name": "con2net/contao-anti-spam-form-bundle",
  "type": "contao-bundle",
  "description": "Multi-Layer Anti-SPAM für Contao Formulare und Mitglieder-Registrierung mit ALTCHA, IP-Blacklist und Content-Analyse",
  "keywords": ["contao", "spam", "protection", "altcha", "captcha", "honeypot", "blacklist", "forms", "registration", "registrierung", "member"],
  "license": "MIT",
  "authors": [
    {
      "name": "con2net webServices",
      "homepage": "https://www.connect2net.de"
    }
  ],
  "require": {
    "php": "^8.2",
    "contao/core-bundle": "^4.13 || ^5.3 || ^5.7",
    "symfony/framework-bundle": "^5.4 || ^6.0 || ^7.0",
    "altcha-org/altcha": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "Con2net\\ContaoAntiSpamFormBundle\\": "src/"
    }
  },
  "extra": {
    "contao-manager-plugin": "Con2net\\ContaoAntiSpamFormBundle\\ContaoManager\\Plugin"
  }
}