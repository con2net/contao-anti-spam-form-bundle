<?php
// File: src/Resources/contao/templates/form_c2n_altcha.html5

/**
 * ALTCHA Widget Template
 *
 * Privacy-first CAPTCHA - GDPR compliant (all assets served locally).
 * Uses challengejson for server-rendered challenge delivery - works on
 * all server configurations without any webserver rules required.
 *
 * @author con2net webServices
 */

$container    = \Contao\System::getContainer();
$altchaService = $container->get('con2net.antispam.altcha_service');

try {
    $maxNumber  = $container->hasParameter('con2net.antispam.altcha.max_number')
            ? (int) $container->getParameter('con2net.antispam.altcha.max_number')
            : 100000;

    $saltLength = $container->hasParameter('con2net.antispam.altcha.salt_length')
            ? (int) $container->getParameter('con2net.antispam.altcha.salt_length')
            : 16;

    $algorithm  = $container->hasParameter('con2net.antispam.altcha.algorithm')
            ? (string) $container->getParameter('con2net.antispam.altcha.algorithm')
            : 'pbkdf2';

    $challenge = $altchaService->createChallenge($maxNumber, $saltLength, $algorithm);

    if (empty($challenge)) {
        throw new \Exception('Challenge creation returned empty array');
    }

    $challengeJson = json_encode($challenge, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES);

} catch (\Exception $e) {
    $loggingHelper = $container->get('con2net.antispam.logging_helper');
    $loggingHelper->logError('ALTCHA challenge error: ' . $e->getMessage(), __METHOD__);

    // Fallback: empty challenge - widget will show error
    $challengeJson = '{}';
}
?>
<div class="widget widget-altcha <?= $this->class ?>">
    <?php if ($this->label): ?>
        <label for="ctrl_<?= $this->id ?>" class="invisible">
            <?= $this->label ?>
            <?php if ($this->mandatory): ?>
                <span class="mandatory">*</span>
            <?php endif; ?>
        </label>
    <?php endif; ?>

    <!-- ALTCHA Widget -->
    <altcha-widget
            id="altcha_<?= $this->id ?>"
            auto="onfocus"
            challenge='<?= htmlspecialchars($challengeJson, ENT_QUOTES, 'UTF-8') ?>'
            workers="4"
            hidefooter="false"
            hidelogo="false"
            strings='{"label":"Ich bin kein Roboter","verifying":"Verifizierung läuft...","verified":"Verifiziert","error":"Fehler bei der Verifizierung"}'
            data-widget-id="<?= $this->id ?>">
    </altcha-widget>

    <!-- Hidden input for challenge response -->
    <input type="hidden"
           name="<?= $this->name ?>"
           id="ctrl_<?= $this->id ?>"
           value="">

    <?php if ($this->hasErrors()): ?>
        <p class="error"><?= $this->getErrorAsString() ?></p>
    <?php endif; ?>
</div>
